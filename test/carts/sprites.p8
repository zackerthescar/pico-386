pico-8 cartridge // http://www.pico-8.com
version 41
__lua__
-- end-to-end sprite/map test scene (see sprites.expect)
function _draw()
 cls(1)
 map(0,0,0,0,4,2)               -- y0-15: tiles, tile 0 shows background
 map(0,0,0,32,4,2,2)            -- layers=2: only sprite 2 (flag 1)
 spr(3,40,0)                    -- white left half, transparent right
 spr(3,56,0,1,1,true)           -- flip_x: white right half
 spr(4,40,16,1,1,false,true)    -- flip_y: blue bottom half
 pal(8,10) spr(1,72,0) pal()    -- red drawn as yellow
 camera(-80,0) spr(1,0,0) camera() -- red at x80, after pal() reset
 sspr(8,0,8,8,96,0,16,16)       -- sprite 1 scaled 2x
 clip(4,64,8,2) spr(2,0,64) clip() -- only x4-7, y64-65
 mset(0,40,2) map(0,40,0,80,1,1) -- map row 40 lives at 0x1000
end
